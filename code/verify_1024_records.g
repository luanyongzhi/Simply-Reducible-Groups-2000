# Independent positive-record audit; does not prove exhaustive coverage or pairwise nonisomorphism.
SR_Wigner := function(G)
 local cl,sizes,reps,roots,i,j,T;
 cl:=ConjugacyClasses(G); sizes:=List(cl,Size); reps:=List(cl,Representative);
 roots:=List(cl,x->0);
 for i in [1..Length(cl)] do
  j:=PositionProperty(cl,C->reps[i]^2 in C);
  roots[j]:=roots[j]+sizes[i]/sizes[j];
 od;
 return Sum([1..Length(cl)],i->sizes[i]*roots[i]^3)
  =Sum(sizes,n->Size(G)^2/n);
end;
