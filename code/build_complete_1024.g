# Reconstruct the combined order-1024 catalogue and export uniform metadata.
# Counts of the inherited class>=3 stratum rely on its original completeness
# and nonredundancy certificate. Every record here is checked for SR.
Read("sr_class2.g");;
LoadPackage("smallgrp");;
SR_CatalogueLines:=[];;
SR_CatalogueAppend:=function(arg)
 Add(SR_CatalogueLines,Concatenation(List(arg,String)));
end;;
SR_CatalogueRows:=0;;SR_CatalogueClass2:=0;;SR_CatalogueHasC2:=0;;
SR_WriteCatalogue:=function(G,source,sourceid,code,expectedclass,expectedhasc2)
 local classes,sizes,reps,roots,i,j,n,s2,s3,inv,Z,D,hasc2,c,k;
 n:=Size(G);c:=NilpotencyClassOfGroup(G);
 if n<>1024 or c<>expectedclass then Error("catalogue metadata mismatch");fi;
 Z:=Centre(G);D:=DerivedSubgroup(G);
 hasc2:=Size(Intersection(Z,D))<Size(Z);
 if hasc2<>expectedhasc2 then Error("central factor flag mismatch");fi;
 classes:=ConjugacyClasses(G);sizes:=List(classes,Size);
 reps:=List(classes,Representative);roots:=List(classes,x->0);k:=Length(classes);
 for i in [1..k] do
  j:=PositionProperty(classes,C->reps[i]^2 in C);
  roots[j]:=roots[j]+sizes[i]/sizes[j];
 od;
 s2:=Sum([1..k],i->sizes[i]*roots[i]^2);
 s3:=Sum([1..k],i->sizes[i]*roots[i]^3);
 if s2<>n*k or s3<>Sum(sizes,x->n^2/x) then Error("catalogue Wigner failure");fi;
 inv:=Sum(Filtered([1..k],i->reps[i]^2=One(G)),i->sizes[i])-1;
 if code=fail then code:=CodePcGroup(G);fi;
 SR_CatalogueRows:=SR_CatalogueRows+1;
 if c=2 then SR_CatalogueClass2:=SR_CatalogueClass2+1;fi;
 if hasc2 then SR_CatalogueHasC2:=SR_CatalogueHasC2+1;fi;
 SR_CatalogueAppend(SR_CatalogueRows,",1024,",c,",",Exponent(G),",",Size(Z),",",Size(D),",",DerivedLength(G),",",k,",",inv,",",hasc2,",",code,",",source,",",sourceid,"\n");
end;
SR_CatalogueAppend("No,Order,Class,Exponent,CenterSize,DerivedSize,DerivedLength,NrConjClasses,Involutions,HasC2DirectFactor,Code,Source,SourceID\n");
SR_WriteCatalogue(ElementaryAbelianGroup(1024),"elementary_abelian",1,fail,1,true);
