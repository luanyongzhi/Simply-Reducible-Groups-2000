SR2_RunAudit:=function()
local row,n,count,stems,id,G,X,P,A;
for row in SR2_audit_ids do
  n:=row[1]; count:=0; stems:=0;
  for id in row[2] do
    G:=SmallGroup(n,id);
    if NilpotencyClassOfGroup(G)=2 then
      X:=SR2_Extract(G);
      if X=fail or not SR2_IsSRData(X.B,X.Q) then Error("CSV SR failed",[n,id]); fi;
      P:=SR2_PolarData(X.B); A:=SR2_RealityAffine(P);
      count:=count+1;
      if X.stem then stems:=stems+1; fi;
      SR2_AppendTo("audited_class2.csv",n,",",id,",",X.m,",",X.r,",",X.stem,",\"",SortedList(P.ranks{[2..Length(P.ranks)]}),"\",",A.dimension,"\n");
    fi;
  od;
  Print("order=",n," CSV_rows=",Length(row[2])," class2=",count," stems=",stems,"\n");
od;
end;
SR2_RunAudit();
QUIT;
